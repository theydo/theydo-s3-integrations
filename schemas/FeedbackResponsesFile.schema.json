{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./FeedbackResponsesFile.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "THEYDO_FEEDBACK_RESPONSES_V1"
    },
    "feedbackMetadata": {
      "type": "object",
      "properties": {
        "feedbackName": {
          "type": "string"
        },
        "feedbackId": {
          "type": "string"
        },
        "feedbackFields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldId": {
                "type": "string"
              },
              "fieldName": {
                "type": "string",
                "minLength": 1
              },
              "fieldType": {
                "default": "TEXT",
                "type": "string",
                "enum": [
                  "TEXT",
                  "TAG_GROUP",
                  "PERSONA",
                  "IGNORE"
                ]
              },
              "tagGroupTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "fieldId",
              "fieldName",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "convertAllRowsToQuotes": {
          "type": "boolean"
        }
      },
      "required": [
        "feedbackName",
        "feedbackId",
        "feedbackFields"
      ],
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "responseId": {
            "type": "string"
          },
          "responseDateTime": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "responseFields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fieldId": {
                  "type": "string"
                },
                "textValue": {
                  "type": "string"
                }
              },
              "required": [
                "fieldId",
                "textValue"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "responseId",
          "responseDateTime",
          "responseFields"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "feedbackMetadata",
    "responses"
  ],
  "additionalProperties": false,
  "title": "FeedbackResponsesFile",
  "description": "JSON import for feedback responses"
}