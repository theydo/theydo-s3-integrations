{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./SupportLogTextFile.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "THEYDO_SUPPORT_LOG_TEXT_V1"
    },
    "sourceSystem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "tags": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "groupTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "groupTitle",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "personas": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "occurredAt",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "sourceSystem",
    "transcript"
  ],
  "additionalProperties": false,
  "title": "SupportLogTextFile",
  "description": "JSON import for a single support-log transcript as plain text"
}