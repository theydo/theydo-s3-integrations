{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./InsightsFile.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "THEYDO_INSIGHTS_V1"
    },
    "insights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Insight"
      },
      "title": "Insights"
    }
  },
  "required": [
    "format",
    "insights"
  ],
  "additionalProperties": false,
  "title": "InsightsFile",
  "description": "JSON import/export for insights",
  "examples": [
    {
      "format": "THEYDO_INSIGHTS_V1",
      "insights": [
        {
          "importKey": "Id-1234",
          "title": "Some insight"
        }
      ]
    }
  ],
  "$defs": {
    "Insight": {
      "type": "object",
      "properties": {
        "importKey": {
          "type": "string",
          "description": "Unique identifier for insight"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "description": "Description with MarkDown syntax",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "empathyScore": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalLinks": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "description": "Status value, create",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "groupTags": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tagGroup": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string"
                  }
                },
                "required": [
                  "tagGroup",
                  "tag"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "weight": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerEmail": {
          "description": "The ownerEmail property has specific rules that it follows. Refer to the Readme section 'Treatment of ownerEmail'",
          "oneOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "personas": {
          "description": "Persona share URLs (.../p/<shareKey>) to link the insight to. Personas that do not exist in the target workspace are ignored.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "importKey",
        "title"
      ],
      "additionalProperties": false,
      "title": "Insight",
      "description": "Data for one insight"
    }
  }
}