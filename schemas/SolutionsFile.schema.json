{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./SolutionsFile.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "THEYDO_SOLUTIONS_V1"
    },
    "solutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Solution"
      },
      "title": "Solutions"
    }
  },
  "required": [
    "format",
    "solutions"
  ],
  "additionalProperties": false,
  "title": "SolutionsFile",
  "description": "JSON import/export for solutions",
  "examples": [
    {
      "format": "THEYDO_SOLUTIONS_V1",
      "solutions": [
        {
          "importKey": "Id-1234",
          "title": "Some solution"
        }
      ]
    }
  ],
  "$defs": {
    "Solution": {
      "type": "object",
      "properties": {
        "importKey": {
          "type": "string",
          "description": "Unique identifier for solution"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "description": "Description with MarkDown syntax",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalLinks": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "groupTags": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tagGroup": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string"
                  }
                },
                "required": [
                  "tagGroup",
                  "tag"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "HIGH",
                "MEDIUM",
                "LOW"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerEmail": {
          "description": "Email of an existing workspace user to set as the owner. Users are never created by import; if no user with this email exists, the owner is left unchanged.",
          "oneOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "importKey",
        "title"
      ],
      "additionalProperties": false,
      "title": "Solution",
      "description": "Data for one solution"
    }
  }
}