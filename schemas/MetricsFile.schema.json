{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./MetricsFile.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "THEYDO_METRICS_V1"
    },
    "metrics": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/MetricCES"
          },
          {
            "$ref": "#/$defs/MetricCSAT"
          },
          {
            "$ref": "#/$defs/MetricNPS"
          },
          {
            "$ref": "#/$defs/MetricOTHER"
          },
          {
            "$ref": "#/$defs/MetricRATIO"
          }
        ],
        "title": "Metric"
      },
      "title": "Metrics"
    }
  },
  "required": [
    "format",
    "metrics"
  ],
  "additionalProperties": false,
  "title": "MetricsFile",
  "description": "JSON import/export for metrics",
  "examples": [
    {
      "format": "THEYDO_METRICS_V1",
      "metrics": [
        {
          "importKey": "Id-1234",
          "title": "Some metric",
          "type": "CES",
          "unit": "%",
          "dataPoints": [
            {
              "dateOfMeasurement": "2020-01-31",
              "score": 15,
              "respondents": 100
            }
          ]
        }
      ]
    }
  ],
